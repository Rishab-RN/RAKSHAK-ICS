# =============================================================================
# RAKSHAK-ICS .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# --- Virtual Environment ---
venv/
env/
.venv/
.env/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb_meta

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Large Data Files & Datasets (NDA-protected) ---
# NEVER commit raw data — SWaT dataset is under NDA
data/swat/*
!data/swat/.gitkeep
data/hai/*
!data/hai/.gitkeep
data/proof/*
!data/proof/.gitkeep
!data/proof/dataset_stats.json

# Block ALL raw data formats anywhere in repo
*.csv
*.xlsx
*.xls
data/**/*.npy
data/**/*.pt
data/**/*.pkl
*.h5
*.hdf5

# --- Model Weights & Checkpoints ---
models/**/*.pt
models/**/*.pth
models/**/*.onnx
models/**/*.ckpt
models/**/*.zip
models/**/*.pkl

# --- Training Logs ---
results/logs/
runs/
tb_logs/
lightning_logs/
wandb/
*.log

# --- TensorBoard ---
*.tfevents.*

# --- Dashboard Frontend ---
dashboard/frontend/node_modules/
dashboard/frontend/dist/
dashboard/frontend/.env

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Archives ---
*.zip
*.tar.gz
*.7z
*.rar

# --- Generated PDFs (keep in plans/) ---
system_design.pdf

# --- External repos ---
external/
